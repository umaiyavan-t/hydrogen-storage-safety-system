# Server Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Local or MongoDB Atlas Free Tier)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@hydrogen-safe-fsd.mtoa8jl.mongodb.net/
# Allowed Frontend Origins (Comma-separated or * for development)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Set to false if connected to real Modbus/OPC-UA hardware PLC
ENABLE_SIMULATOR=true
